---
import defs from '../assets/defs.json'
import Layout from '../layouts/Layout.astro'

const parts = defs['CWF.PartDef']

const modules = defs.ThingDef.filter(
  def => def.defName && def.modExtensions,
).map(module => {
  const traitName = module.modExtensions![0].weaponTraitDef
  const trait = defs.WeaponTraitDef.find(trait => trait.defName === traitName)
  return Object.assign(module, trait)
})

const style = parts
  .map(
    ({ defName }) => `
    main:has([data-part-filter="${defName}"]:checked) [data-part="${defName}"] {
      display: block;
    }`,
  )
  .join('\n')
---

<Layout>
  <style is:inline set:html={style}></style>

  <form>
    {
      parts.map(({ defName, label }) => (
        <label>
          <span>{label}</span>
          <input
            checked
            data-part-filter={defName}
            name="part"
            type="checkbox"
            value={defName}
          />
        </label>
      ))
    }
  </form>

  <article>
    {
      modules.map(module => (
        <section
          data-part={(module.modExtensions![0] as { part: string }).part}
        >
          <h2>{module.label}</h2>
          <p>{module.description}</p>

          {module.statOffsets && (
            <>
              <h3>StatOffsets</h3>
              <div class="stats">
                {Object.entries(module.statOffsets).map(([key, value]) => (
                  <p>
                    {key}: {value}
                  </p>
                ))}
              </div>
            </>
          )}

          {module.statFactors && (
            <>
              <h3>StatFactors</h3>
              <div class="stats">
                {Object.entries(module.statFactors).map(([key, value]) => (
                  <p>
                    {key}: {value}
                  </p>
                ))}
              </div>
            </>
          )}

          <details>
            <summary>Source</summary>
            <pre>{JSON.stringify(module, null, 2)}</pre>
          </details>
        </section>
      ))
    }
  </article>
</Layout>

<style>
  form {
    display: flex;
    flex-wrap: wrap;
    gap: 0 8px;

    label {
      display: flex;
      align-items: center;

      span {
        text-transform: capitalize;
      }
    }
  }

  article {
    margin-top: 16px;
  }

  section {
    display: none;

    &:not(:last-of-type) {
      margin-bottom: 24px;
    }
  }

  h2 {
    font-size: 1.125rem;
    text-transform: capitalize;
  }

  .stats {
    font-family: 'PT Mono';
  }

  h3,
  details {
    margin-top: 4px;
  }
</style>
