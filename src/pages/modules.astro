---
import defs from '../assets/defs.json'
import Layout from '../layouts/Layout.astro'
import PartFilter from '../components/PartFilter.vue'

const modules = defs.ThingDef.filter(
  def => def.defName && def.modExtensions,
).map(module => {
  const traitName = module.modExtensions![0].weaponTraitDef
  const trait = defs.WeaponTraitDef.find(trait => trait.defName === traitName)
  return Object.assign(module, trait)
})
---

<script>
  import emitter from '../utils/emitter'

  const modules = document.querySelectorAll<HTMLElement>('[data-part]')

  emitter.on('changeFilteredParts', parts => {
    modules.forEach(module => {
      module.hidden = !parts.includes(module.dataset.part!)
    })
  })
</script>

<Layout>
  <PartFilter client:load parts={defs['CWF.PartDef']} />

  <article>
    {
      modules.map(module => (
        <section
          data-part={(module.modExtensions![0] as { part: string }).part}
        >
          <h2>{module.label}</h2>
          <p>{module.description}</p>

          {module.statOffsets &&
            <h3>StatOffsets</h3>
            <div class="stats">{Object.entries(module.statOffsets).map(([k,v])=> <p>{k}: {v}</p>)}</div>
          }

          {module.statFactors &&
            <h3>StatFactors</h3>
            <div class="stats">{Object.entries(module.statFactors).map(([k,v])=> <p>{k}: {v}</p>)}</div>
          }

          <details>
            <summary>Source</summary>
            <pre>{JSON.stringify(module, null, 2)}</pre>
          </details>
        </section>
      ))
    }
  </article>
</Layout>

<style>
  article {
    margin-top: 16px;
  }

  section:not(:last-of-type) {
    margin-bottom: 24px;
  }

  h2 {
    font-size: 1.125rem;
    text-transform: capitalize;
  }

  .stats {
    font-family: 'PT Mono';
  }

  h3,details {
    margin-top: 4px;
  }
</style>
