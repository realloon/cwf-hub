---
import defs from '../assets/defs.json'
import Layout from '../layouts/Layout.astro'
import PartFilter from '../components/PartFilter.vue'
---

<Layout>
  <h1>modules</h1>

  <PartFilter
    client:load
    parts={defs['CWF.PartDef'].map(def => ({
      id: def.defName,
      label: def.label,
    }))}
  />

  {
    defs.ThingDef.map(module => (
      <section>
        <h3>{module.label}</h3>
        <pre>{JSON.stringify(module, null, 2)}</pre>
      </section>
    ))
  }
</Layout>

<style>
  .parts {
    display: flex;
    gap: 4px;
  }
</style>
