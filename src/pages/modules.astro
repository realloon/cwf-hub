---
import defs from '../assets/defs.json'
import Layout from '../layouts/Layout.astro'
import PartFilter from '../components/PartFilter.vue'
import ModuleList from '../components/ModuleList.vue'
---

<Layout>
  <PartFilter
    client:load
    parts={defs['CWF.PartDef'].map(def => ({
      id: def.defName,
      label: def.label,
    }))}
  />

  <ModuleList moudles={defs.ThingDef.filter(thing => thing.modExtensions)} />
</Layout>

<style>
  .parts {
    display: flex;
    gap: 4px;
  }
</style>
