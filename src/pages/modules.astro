---
import defs from '../assets/defs.json'
import Layout from '../layouts/Layout.astro'
import PartFilter from '../components/PartFilter.vue'
---

<Layout>
  <PartFilter client:load parts={defs['CWF.PartDef']} />

  {
    defs.WeaponTraitDef.filter(def => def.defName).map(def => (
      <section>
        <details>
          <summary>{def.label}</summary>
          <pre>{JSON.stringify(def, null, 2)}</pre>
        </details>
      </section>
    ))
  }
</Layout>
